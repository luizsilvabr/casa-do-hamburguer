# Conexão com o PostgreSQL (usada pela API e pelo Prisma CLI)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/casa_do_hamburguer"

# Segredo usado para assinar o JWT do admin. Gere um valor longo e aleatório.
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Primeiro admin, criado por `npx prisma db seed` (senha com no mínimo 6 caracteres)
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@exemplo.com"
SEED_ADMIN_PASSWORD="troque-esta-senha"

# Opcionais — valores abaixo são os padrões do código
# JWT_EXPIRES_IN="7d"
# PORT=3333
# FRONTEND_URL="http://localhost:5173"
